  ============================
  ∀ n : SI, x ≡{n}≡ z ↔ ∃ x0 : A, x ≡{n}≡ x0 ∧ x0 ≡{n}≡ z
"test_wand_iff_exist"
     : string
1 goal
  
  SI : sidx
  PROP : bi
  Sbi0 : Sbi PROP
  A : ofe
  x, z : A
  ============================
  ∀ n : SI,
    (∀ n' : SI, (n' < n)%sidx → x ≡{n'}≡ z)
    ↔ ∃ x0 : A, ∀ n' : SI, (n' < n)%sidx → x ≡{n'}≡ x0 ∧ x0 ≡{n'}≡ z
"test_exist_impl"
     : string
1 goal
  
  SI : sidx
  PROP : bi
  Sbi0 : Sbi PROP
  A : ofe
  x, z : A
  ============================
  ∀ n : SI,
    x ≡{n}≡ z
    → ∃ x0 : A, ∀ n' : SI, (n' ≤ n)%sidx → x ≡{n'}≡ x0 → x0 ≡{n'}≡ z
"test_forall_impl"
     : string
1 goal
  
  SI : sidx
  PROP : bi
  Sbi0 : Sbi PROP
  A : ofe
  x, z : A
  ============================
  ∀ n : SI,
    (∀ (x0 : A) (n' : SI), (n' ≤ n)%sidx → x ≡{n'}≡ x0 → x0 ≡{n'}≡ z)
    → x ≡{n}≡ z
