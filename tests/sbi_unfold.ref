"test_impl"
     : string
1 goal
  
  SI : sidx
  PROP : bi
  Sbi0 : Sbi PROP
  A : ofe
  x, y, z : A
  ============================
  ∀ n : SI, x ≡{n}≡ y → y ≡{n}≡ z → x ≡{n}≡ z
"test_impl_impl_and"
     : string
1 goal
  
  SI : sidx
  PROP : bi
  Sbi0 : Sbi PROP
  A : ofe
  x, y, z : A
  ============================
  ∀ n : SI, x ≡{n}≡ y → y ≡{n}≡ z → x ≡{n}≡ z ∧ z ≡{n}≡ x
"test_exist_impl"
     : string
1 goal
  
  SI : sidx
  PROP : bi
  Sbi0 : Sbi PROP
  A : ofe
  x, z : A
  ============================
  ∀ n : SI, (∃ x0 : A, x ≡{n}≡ x0 ∧ x0 ≡{n}≡ z) → x ≡{n}≡ z
