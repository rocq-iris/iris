# Specification for custom Rocq compilation flags (turns into `-arg` values in `_RocqProject`).
# Syntax:
# - One flag per line with no leading/trailing blanks.
# - Empty lines and lines starting with '#' are ignored.

# We sometimes want to locally override notation, and there is no good way to do
# that with scopes.
-w
-notation-overridden

# Cannot use non-canonical projections as it causes massive unification failures
# (https://github.com/coq/coq/issues/6294).
-w
-redundant-canonical-projection

# Needs Rocq 9.2.
-w
-notation-for-abbreviation

# Needs Rocq 9.2 at least for Scheme Rewrite; it is unclear whether the warning
# is also used for other schemes.
-w
-missing-scheme

# The ltac_expr case of this is very annoying to deal with so we are hoping for
# better alternatives (https://github.com/rocq-prover/rocq/issues/21896).
-w
-level-tolerance

# This warning has many false positives
# (https://github.com/rocq-prover/rocq/issues/21916).
-w
-postfix-notation-not-level-1

# Overwrite some default Rocq options
-set
'Default Goal Selector=!'
-set
'Default Proof Using=Type'
-set
'Suggest Proof Using'
